# Override Config (Europa Universalis V)
#
# See `cwt/core/00_overrides.cwt` for the format, strategies, confidence labels and sources.
# Only game-specific entries are listed here; unmatched paths default to `lios`.
#
# Game-specific source:
# - Official Europa Universalis V Wiki, "Mod compatibility":
#   https://eu5.paradoxwikis.com/Mod_compatibility
#
# Note: GUI types/templates are last-in, only served (LIOS) in EU5 and therefore need no entry.
#
# See: docs/en/ref-config-format.md#config-override
# Version: 3.0.4-dev
# Date: 2026-10-02

overrides = {
    # [high] Wiki: events/on_actions/random_events are appended; trigger/effect cannot be replaced
    # without a whole-file override.
    "common/on_actions" = ordered

    # [high] Wiki: the first loaded wins.
    "events" = fios

    # [high] Wiki: later keys do not overwrite earlier ones; the replace folder wins.
    "localization" = fios
}
